# Copy this file, and name the copy ".env" (same folder). Then fill in the
# three values. Git ignores ".env", so your values stay on your PC.
#
# Only PUBLIC values go here. Everything in ".env" ships inside the app.
# Never put a Supabase "secret" key, a "service_role" key or a database
# password in this file.

# Supabase dashboard > Project Settings > Data API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard > Project Settings > API Keys > Publishable key
# (starts with "sb_publishable_")
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# PowerSync dashboard > your instance > Connect > Instance URL
POWERSYNC_URL=https://your-instance-id.powersync.journeyapps.com

# Only needed for the access-rule test (test/integration/rls_test.dart).
# Copy this file, name the copy ".env.test", and fill in two TEST accounts
# that you created in the app. Git ignores ".env.test" and it is not put in
# the app. Use throwaway accounts, not your real one.

RLS_TEST_EMAIL_A=first-test-account@example.com
RLS_TEST_PASSWORD_A=
RLS_TEST_EMAIL_B=second-test-account@example.com
RLS_TEST_PASSWORD_B=
